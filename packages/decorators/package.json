{
  "name": "@nextrush/decorators",
  "version": "3.1.0",
  "description": "DEPRECATED: Metadata-only decorators for NextRush controllers. Use @nextrush/class instead.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo 'Tests moved to @nextrush/class'",
    "test:watch": "echo 'Tests moved to @nextrush/class'",
    "test:coverage": "echo 'Tests moved to @nextrush/class'",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nextrush/class": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "nextrush",
    "decorators",
    "deprecated",
    "shim"
  ],
  "author": {
    "name": "Tanzim Hossain",
    "email": "tanzimhossain2@gmail.com",
    "url": "https://github.com/0xTanzim"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/0xTanzim/nextRush/tree/main/packages/decorators#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xTanzim/nextRush.git",
    "directory": "packages/decorators"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
