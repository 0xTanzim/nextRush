{
  "name": "nextrush-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "NextRush v3 — minimal, modular TypeScript HTTP stack for Node.js and other runtimes",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "simple-git-hooks",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run verify && pnpm validate:bins && pnpm validate:esm-only && pnpm validate:manifest-composition && pnpm check:coverage",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "clean:modules": "bash scripts/clean-modules.sh",
    "update:all": "bash scripts/update-all.sh",
    "fresh": "bash scripts/fresh-install.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "docs:validate": "tsx scripts/docs/build-docs.ts",
    "docs:validate:strict": "tsx scripts/docs/build-docs.ts --strict",
    "validate:bins": "tsx scripts/validate-bins.ts",
    "validate:esm-only": "tsx scripts/validate-esm-only.ts",
    "validate:manifest-composition": "tsx scripts/validate-manifest-composition.ts",
    "validate:changeset-baselines": "tsx scripts/validate-changeset-baselines.ts",
    "verify:release-state": "tsx scripts/verify-release-state.ts",
    "check:coverage": "tsx scripts/check-coverage.ts",
    "changeset": "changeset",
    "version": "pnpm validate:changeset-baselines && pnpm verify:release-state && changeset version",
    "release:check": "pnpm verify:release-state && pnpm validate:changeset-baselines",
    "release": "turbo run build && changeset publish",
    "create": "node packages/create-nextrush/bin/create-nextrush.js"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:node",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "catalog:testing",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "miniflare": "5.20260801.0-alpha",
    "prettier": "^3.9.6",
    "simple-git-hooks": "2.13.1",
    "tsup": "catalog:tooling",
    "tsx": "catalog:tooling",
    "turbo": "^2.10.8",
    "typescript": "catalog:tooling",
    "typescript-eslint": "^8.66.0",
    "vitest": "catalog:testing"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xTanzim/nextRush.git"
  },
  "homepage": "https://github.com/0xTanzim/nextRush",
  "bugs": {
    "url": "https://github.com/0xTanzim/nextRush/issues"
  },
  "author": {
    "name": "Tanzim Hossain",
    "email": "tanzimhossain2@gmail.com",
    "url": "https://github.com/0xTanzim"
  },
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec tsx scripts/git-hooks/pre-commit.ts",
    "pre-push": "pnpm exec tsx scripts/git-hooks/pre-push.ts"
  }
}
