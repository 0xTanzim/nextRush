{
  "name": "nextrush-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "NextRush v3 — minimal, modular TypeScript HTTP stack for Node.js and other runtimes",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run verify && pnpm validate:bins && pnpm validate:esm-only && pnpm check:coverage",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "clean:modules": "bash scripts/clean-modules.sh",
    "update:all": "bash scripts/update-all.sh",
    "fresh": "bash scripts/fresh-install.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "docs:validate": "tsx scripts/docs/build-docs.ts",
    "docs:validate:strict": "tsx scripts/docs/build-docs.ts --strict",
    "validate:bins": "tsx scripts/validate-bins.ts",
    "validate:esm-only": "tsx scripts/validate-esm-only.ts",
    "check:coverage": "tsx scripts/check-coverage.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish --provenance",
    "create": "node packages/create-nextrush/bin/create-nextrush.js"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "miniflare": "^4.20260714.0",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xTanzim/nextRush.git"
  },
  "homepage": "https://github.com/0xTanzim/nextRush",
  "bugs": {
    "url": "https://github.com/0xTanzim/nextRush/issues"
  },
  "author": {
    "name": "Tanzim Hossain",
    "email": "tanzimhossain2@gmail.com",
    "url": "https://github.com/0xTanzim"
  },
  "license": "MIT"
}
