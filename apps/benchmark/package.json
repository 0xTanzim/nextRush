{
  "name": "nextrush-benchmark",
  "version": "3.0.3",
  "description": "Professional HTTP framework benchmarks for NextRush v3 — wrk + autocannon, GC tracking, memory profiling, concurrency scaling",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node scripts/run.js",
    "bench:quick": "node scripts/run.js --profile quick",
    "bench:standard": "node scripts/run.js --profile standard",
    "bench:full": "node scripts/run.js --profile full",
    "bench:stress": "node scripts/run.js --profile stress",
    "bench:compare": "node scripts/run.js --compare",
    "bench:wrk": "node scripts/run.js --tool wrk",
    "bench:autocannon": "node scripts/run.js --tool autocannon",
    "bench:nextrush": "node scripts/run.js --framework nextrush-v3",
    "bench:baseline": "node scripts/run.js --framework raw-node",
    "bench:alloc": "node scripts/alloc/compose-alloc.js",
    "bench:alloc:dispatch": "node scripts/alloc/dispatch-alloc.js",
    "bench:alloc:context": "node scripts/alloc/context-alloc.js",
    "bench:alloc:context-raw": "node scripts/alloc/context-raw-alloc.js",
    "bench:alloc:context-state": "node scripts/alloc/context-state-alloc.js",
    "bench:alloc:router": "node scripts/alloc/router-match-alloc.js",
    "bench:alloc:param-match": "node scripts/alloc/param-match-alloc.js",
    "bench:alloc:handler": "node scripts/alloc/handler-alloc.js",
    "bench:alloc:web": "node scripts/alloc/web-context-alloc.js",
    "bench:validate": "node scripts/validate-parity.js",
    "bench:verify": "node scripts/run.js --profile verify --rotate --compare --scenario hello-world",
    "bench:check": "node scripts/check-regression.js",
    "bench:mixed": "wrk -t4 -c64 -d10s -s wrk/mixed.lua http://localhost:8080/",
    "smoke-test": "node scripts/smoke-test.js",
    "test": "node --test scripts/lib/__tests__/*.test.js",
    "report:generate": "node scripts/generate-report.js",
    "report:regenerate-all": "node scripts/generate-report.js --all --history",
    "report:history": "node scripts/generate-report.js --history",
    "clean": "rm -rf results/*",
    "bench:mount-scaling": "node scripts/alloc/mount-scaling.js"
  },
  "devDependencies": {
    "@fastify/static": "10.1.2",
    "@hono/node-server": "2.0.10",
    "@nextrush/adapter-node": "workspace:*",
    "@nextrush/body-parser": "workspace:*",
    "@nextrush/class": "workspace:*",
    "@nextrush/core": "workspace:*",
    "@nextrush/router": "workspace:*",
    "@nextrush/runtime": "workspace:*",
    "@nextrush/static": "workspace:*",
    "@nextrush/types": "workspace:*",
    "autocannon": "8.0.0",
    "express": "5.2.1",
    "fastify": "5.10.0",
    "hono": "4.12.30",
    "koa": "3.2.1",
    "koa-bodyparser": "4.4.1",
    "koa-router": "14.0.0",
    "koa-static": "5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
