{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/src/config/schema.json",
  "plugins": ["react", "nextjs", "jsx-a11y", "import"],
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "public/**",
    ".source/**",
    ".verify-snippets-*/**",
    "next-env.d.ts",
    "playwright-report/**",
    "test-results/**"
  ],
  "rules": {
    "react/display-name": "deny",
    "react/jsx-key": "deny",
    "react/jsx-no-comment-textnodes": "deny",
    "react/jsx-no-duplicate-props": "deny",
    "react/jsx-no-target-blank": "off",
    "react/jsx-no-undef": "deny",
    "react/no-children-prop": "deny",
    "react/no-danger-with-children": "deny",
    "react/no-direct-mutation-state": "deny",
    "react/no-find-dom-node": "deny",
    "react/no-is-mounted": "deny",
    "react/no-render-return-value": "deny",
    "react/no-string-refs": "deny",
    "react/no-unescaped-entities": "deny",
    "react/no-unknown-property": "off",
    "react/no-unsafe": "off",
    "react/react-in-jsx-scope": "off",
    "react/require-render-return": "deny",
    "react/rules-of-hooks": "deny",
    "react/exhaustive-deps": "warn",
    "react/static-components": "deny",
    "react/use-memo": "deny",
    "react/preserve-manual-memoization": "deny",
    "react/incompatible-library": "warn",
    "react/immutability": "deny",
    "react/globals": "deny",
    "react/refs": "deny",
    "react/set-state-in-effect": "deny",
    "react/error-boundaries": "deny",
    "react/purity": "deny",
    "react/set-state-in-render": "deny",
    "react/unsupported-syntax": "warn",
    "nextjs/google-font-display": "warn",
    "nextjs/google-font-preconnect": "warn",
    "nextjs/next-script-for-ga": "warn",
    "nextjs/no-async-client-component": "warn",
    "nextjs/no-before-interactive-script-outside-document": "warn",
    "nextjs/no-css-tags": "warn",
    "nextjs/no-head-element": "warn",
    "nextjs/no-html-link-for-pages": "deny",
    "nextjs/no-img-element": "warn",
    "nextjs/no-page-custom-font": "warn",
    "nextjs/no-styled-jsx-in-document": "warn",
    "nextjs/no-sync-scripts": "deny",
    "nextjs/no-title-in-document-head": "warn",
    "nextjs/no-typos": "warn",
    "nextjs/no-unwanted-polyfillio": "warn",
    "nextjs/inline-script-id": "deny",
    "nextjs/no-assign-module-variable": "deny",
    "nextjs/no-document-import-in-page": "deny",
    "nextjs/no-duplicate-head": "deny",
    "nextjs/no-head-import-in-document": "deny",
    "nextjs/no-script-component-in-head": "deny",
    "import/no-anonymous-default-export": "warn",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/aria-props": "warn",
    "jsx-a11y/aria-proptypes": "warn",
    "jsx-a11y/aria-unsupported-elements": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "jsx-a11y/role-supports-aria-props": "warn"
  }
}
