{
  "name": "website",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "prebuild": "bun x fumadocs-mdx && bun scripts/generate-openapi.ts && bun scripts/generate-api-catalog.ts",
    "build": "next build && bun ../../scripts/docs/postbuild.ts",
    "dev": "bun x fumadocs-mdx && next dev -p 3020",
    "start": "serve out",
    "types:check": "bun x fumadocs-mdx && next typegen && tsc --noEmit",
    "typecheck": "pnpm types:check",
    "docs:verify-registry": "bun scripts/verify-registry-parity.ts",
    "lint": "oxlint",
    "docs:verify": "bun scripts/verify/index.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-popover": "^1.1.23",
    "@scalar/api-reference-react": "0.9.60",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-twoslash": "4.0.3",
    "fumadocs-typescript": "5.5.2",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "^1.29.0",
    "mermaid": "^11.16.1",
    "next": "catalog:web",
    "next-themes": "^0.4.6",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "zbsearch": "^4.0.0",
    "zod": "catalog:tooling"
  },
  "devDependencies": {
    "@nextrush/openapi": "workspace:*",
    "@nextrush/types": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:node",
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:tooling"
  }
}
