{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "fumadocs-mdx && tsx scripts/generate-openapi.ts && tsx scripts/generate-api-catalog.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=3072 next build && tsx ../../scripts/docs/postbuild.ts",
    "dev": "fumadocs-mdx && next dev -p 3020",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && NODE_OPTIONS=--max-old-space-size=3048 tsc --noEmit",
    "typecheck": "pnpm types:check",
    "docs:verify-registry": "tsx scripts/verify-registry-parity.ts",
    "lint": "eslint",
    "docs:verify": "tsx scripts/verify/index.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-popover": "^1.1.23",
    "@scalar/api-reference-react": "0.9.58",
    "@shikijs/twoslash": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.7.11",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-typescript": "5.3.0",
    "fumadocs-ui": "16.7.11",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.3",
    "postcss": "^8.5.24",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "^6.0.3"
  }
}
